+class PublicationAuthorsTest(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.root = Path(self.directory.name)
+        snapshot = self.root / 'metadata/dblp-audit-20261015'
+        snapshot.mkdir(parents=True)
+        self.record = 'https://dblp.org/rec/journals/corr/abs-2501-00001'
+        self.url = 'https://proceedings.mlr.press/v306/example26.html'
+        self.title = 'A test retrieval paper'
+        (snapshot / 'verified-records.json').write_text(json.dumps([{
+            'dblp_url': self.record,
+            'properties': {'title': [self.title]},
+            'authors': [{'ordinal': 1, 'name': 'Alice'}, {'ordinal': 2, 'name': 'Bob'}],
+        }]))
+        self.metadata = self.root / 'metadata/catalog-update-test'
+        self.metadata.mkdir()
+        self.paper = {
+            'dblp_url': self.record, 'dblp_records': [self.record], 'title': self.title,
+            'authors': ['Alice', 'Carol', 'Bob'], 'publication_status': 'proceedings',
+            'publication_source': self.url, 'publication_author_source': self.url,
+            'paper_url': self.url, 'year': 2026, 'venue': 'ICML',
+        }
+        self.evidence = {
+            'paper_url': self.url, 'source_url': self.url, 'publisher': 'PMLR',
+            'dblp_url': self.record, 'title': self.title,
+            'authors': ['Alice', 'Carol', 'Bob'], 'year': 2026, 'venue': 'ICML',
+            'citation_metadata': [
+                {'name': 'citation_publisher', 'content': 'PMLR'},
+                {'name': 'citation_title', 'content': self.title},
+                {'name': 'citation_abstract_html_url', 'content': self.url},
+            ] + [{'name': 'citation_author', 'content': name} for name in ['Alice', 'Carol', 'Bob']],
+        }
+
+    def check(self, paper=None, evidence=None):
+        (self.metadata / 'proceedings.json').write_text(json.dumps({
+            'publication_author_evidence': [] if evidence is False else [evidence or self.evidence],
+        }))
+        with patch.object(catalog, 'ROOT', self.root):
+            catalog.validate_evidence({'papers': [paper or self.paper]})
+
+    def test_verified_proceedings_can_add_an_author(self):
+        self.check()
+
+    def test_dblp_authors_remain_the_default(self):
+        paper = copy.deepcopy(self.paper)
+        del paper['publication_author_source']
+        with self.assertRaises(AssertionError):
+            self.check(paper)
+        paper['authors'] = ['Alice', 'Bob']
+        self.check(paper)
+
+    def test_missing_or_unrelated_evidence_fails(self):
+        with self.assertRaises(AssertionError):
+            self.check(evidence=False)
+        for field, value in [('dblp_url', self.record + '-other'), ('title', 'Another paper'), ('publisher', 'Unknown')]:
+            with self.subTest(field=field):
+                evidence = copy.deepcopy(self.evidence)
+                evidence[field] = value
+                with self.assertRaises(AssertionError):
+                    self.check(evidence=evidence)
+
+    def test_unsupported_author_changes_fail(self):
+        paper = copy.deepcopy(self.paper)
+        paper['authors'] = ['Alice', 'Mallory', 'Bob']
+        with self.assertRaises(AssertionError):
+            self.check(paper)
+        for authors in [['Alice', 'Carol'], ['Bob', 'Carol', 'Alice']]:
+            with self.subTest(authors=authors):
+                paper = copy.deepcopy(self.paper)
+                evidence = copy.deepcopy(self.evidence)
+                paper['authors'] = evidence['authors'] = authors
+                evidence['citation_metadata'] = [item for item in evidence['citation_metadata'] if item['name'] != 'citation_author']
+                evidence['citation_metadata'] += [{'name': 'citation_author', 'content': name} for name in authors]
+                with self.assertRaises(AssertionError):
+                    self.check(paper, evidence)
+
+    def test_unverified_dblp_identity_fails(self):
+        paper = copy.deepcopy(self.paper)
+        paper['dblp_url'] += '-unverified'
+        with self.assertRaises(AssertionError):
+            self.check(paper)
+
+    def test_proceedings_citation_metadata_must_match(self):
+        for field in ['citation_title', 'citation_abstract_html_url', 'citation_author']:
+            with self.subTest(field=field):
+                evidence = copy.deepcopy(self.evidence)
+                next(item for item in evidence['citation_metadata'] if item['name'] == field)['content'] = 'Unsupported value'
+                with self.assertRaises(AssertionError):
+                    self.check(evidence=evidence)
+
+    def test_override_requires_matching_formal_pmlr_source(self):
+        for field, value in [('publication_status', 'preprint'), ('publication_source', self.url + '?other'), ('paper_url', 'https://arxiv.org/abs/2501.00001')]:
+            with self.subTest(field=field):
+                paper = copy.deepcopy(self.paper)
+                paper[field] = value
+                with self.assertRaises(AssertionError):
+                    self.check(paper)
+
+
+if __name__ == '__main__':
+    unittest.main()
