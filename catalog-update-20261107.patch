+def proceedings_authors(p, source_names, evidence):
+    """Verify an explicitly selected final author list against PMLR evidence."""
+    source = p['publication_author_source']
+    parsed = urlparse(source)
+    assert parsed.scheme == 'https' and parsed.netloc == 'proceedings.mlr.press'
+    assert p['publication_status'] == 'proceedings'
+    assert '/journals/corr/' in p['dblp_url'], 'Author override is limited to a DBLP preprint identity'
+    assert source == p.get('publication_source') == p['paper_url']
+    record = evidence.get(source)
+    assert record, 'Final authors require saved proceedings evidence'
+    assert record['source_url'] == source and record['publisher'] == 'PMLR'
+    assert record['dblp_url'] == p['dblp_url'] and record['title'] == p['title']
+    assert record['year'] == p['year'] and record['venue'] == p['venue']
+    authors = record['authors']
+    assert authors and all(isinstance(name, str) and name.strip() for name in authors)
+    citation = {}
+    for item in record['citation_metadata']:
+        citation.setdefault(item['name'], []).append(item['content'])
+    assert citation.get('citation_publisher') == ['PMLR']
+    assert citation.get('citation_title') == [p['title']]
+    assert citation.get('citation_abstract_html_url') == [source]
+    assert citation.get('citation_author') == authors
+    remaining = iter(authors)
+    for name in source_names:
+        assert any(candidate == name for candidate in remaining), 'DBLP authors must retain their relative order'
+    return authors
+
